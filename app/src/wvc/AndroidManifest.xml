<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="com.chitour.familycast.MainActivity" android:exported="true">
            <!-- يلتقط كل ما ترسله تطبيقات الأفلام إلى زر البث مهما كانت صيغته -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="http"/>
                <data android:scheme="https"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:scheme="rtsp"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="http"/>
                <data android:scheme="https"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>
        <!-- أسماء شاشات قد يطلبها تطبيق الأفلام بالاسم -->
        <activity-alias android:name="com.instantbits.cast.webvideo.WebBrowser"
            android:targetActivity="com.chitour.familycast.MainActivity" android:exported="true"/>
        <activity-alias android:name="com.instantbits.cast.webvideo.MainActivity"
            android:targetActivity="com.chitour.familycast.MainActivity" android:exported="true"/>
        <activity-alias android:name="com.instantbits.cast.webvideo.SplashActivity"
            android:targetActivity="com.chitour.familycast.MainActivity" android:exported="true"/>
        <activity-alias android:name="com.instantbits.cast.webvideo.IntentHandlerActivity"
            android:targetActivity="com.chitour.familycast.MainActivity" android:exported="true"/>
        <activity-alias android:name="com.instantbits.cast.webvideo.videolist.VideoListActivity"
            android:targetActivity="com.chitour.familycast.MainActivity" android:exported="true"/>
    </application>
</manifest>
